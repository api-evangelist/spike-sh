        {
          "info": {
            "name": "Set severity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.spike.sh/incidents/severity",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set the severity for one or more incidents."
        },
        {
          "info": {
            "name": "Remove priority",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.spike.sh/incidents/priority/remove",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove priority from one or more incidents."
