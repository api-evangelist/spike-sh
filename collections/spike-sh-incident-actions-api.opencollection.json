        {
          "info": {
            "name": "Unacknowledge incident",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.spike.sh/incidents/unacknowledge",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Unacknowledge one or more incidents."
        },
        {
          "info": {
            "name": "Set priority",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.spike.sh/incidents/priority",
            "headers": [
              {
                "name": "x-team-id",
                "value": ""
